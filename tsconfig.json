{
  "compilerOptions": {
    "types": ["@webgpu/types"],

    // Environment
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],

    // Module handling — "Preserve" + "bundler" is the correct pair for Rollup
    "module": "Preserve",
    "moduleResolution": "bundler",

    // Output
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,

    // Correctness
    "strict": true,
    "verbatimModuleSyntax": true,       // replaces isolatedModules; enforces import type
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    // Interop
    "importHelpers": true,              // still useful to reduce tslib duplication
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}