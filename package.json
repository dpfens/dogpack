{
  "name": "dogpack-ui",
  "displayName": "DoG Studio",
  "version": "0.1.5",
  "repository": {
    "url": "https://github.com/dpfens/dogpack#gh-pages"
  },
  "bugs": {
    "url": "https://github.com/dpfens/dogpack/issues"
  },
  "keywords": ["difference-of-guassians", "images", "webgpu", "sketch"],
  "description": "A web application for producing sketch-ified images using Difference-of-Gaussians",
  "scripts": {
    "prebuild": "node scripts/generate-version.js",
    "prestart": "node scripts/generate-version.js",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:dogpack": "node dist/dogpack/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.1.2",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "dogpack": "git+https://github.com/dpfens/dogpack.git#v0.1.6",
    "express": "^5.1.0",
    "mediabunny": "^1.52.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.28.1": true,
    "esbuild@0.27.7": true,
    "lmdb@3.5.4": true,
    "msgpackr-extract@3.0.4": true
  }
}
