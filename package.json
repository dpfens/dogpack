{
  "name": "dogpack",
  "version": "0.1.6",
  "description": "Fast, GPU-accelerated Difference-of-Gaussians (XDoG, FDoG, ADoG, HDoG) for line drawing and edge stylization, with WebGPU/WebGL2 acceleration and automatic CPU fallback.",
  "license": "Apache-2.0",
  "author": "Doug Fenstermacher",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/bundle/index.umd.min.js",
  "jsdelivr": "./dist/bundle/index.umd.min.js",
  "browser": "./dist/bundle/index.umd.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./dog": {
      "types": "./dist/types/dog/index.d.ts",
      "import": "./dist/esm/dog/index.js",
      "require": "./dist/cjs/dog/index.js"
    },
    "./blur": {
      "types": "./dist/types/blur/index.d.ts",
      "import": "./dist/esm/blur/index.js",
      "require": "./dist/cjs/blur/index.js"
    },
    "./etf": {
      "types": "./dist/types/etf/index.d.ts",
      "import": "./dist/esm/etf/index.js",
      "require": "./dist/cjs/etf/index.js"
    },
    "./extensions": {
      "types": "./dist/types/extensions/index.d.ts",
      "import": "./dist/esm/extensions/index.js",
      "require": "./dist/cjs/extensions/index.js"
    },
    "./preprocess": {
      "types": "./dist/types/preprocess/index.d.ts",
      "import": "./dist/esm/preprocess/index.js",
      "require": "./dist/cjs/preprocess/index.js"
    },
    "./threshold": {
      "types": "./dist/types/threshold.d.ts",
      "import": "./dist/esm/threshold.js",
      "require": "./dist/cjs/threshold.js"
    },
    "./utils": {
      "types": "./dist/types/utils/index.d.ts",
      "import": "./dist/esm/utils/index.js",
      "require": "./dist/cjs/utils/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "dog": [
        "./dist/types/dog/index.d.ts"
      ],
      "blur": [
        "./dist/types/blur/index.d.ts"
      ],
      "etf": [
        "./dist/types/etf/index.d.ts"
      ],
      "extensions": [
        "./dist/types/extensions/index.d.ts"
      ],
      "preprocess": [
        "./dist/types/preprocess/index.d.ts"
      ],
      "threshold": [
        "./dist/types/threshold.d.ts"
      ],
      "utils": [
        "./dist/types/utils/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && npm run build:shaders && npm run build:all",
    "build:all": "npm run build:unbundled && npm run build:bundle",
    "build:shaders": "node scripts/build-shaders.mjs",
    "build:unbundled": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
    "build:bundle": "rollup -c rollup.config.mjs",
    "prepare": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.1",
    "@webgpu/types": "^0.1.71",
    "rimraf": "^6.0.1",
    "rollup": "^4.25.0",
    "rollup-plugin-dts": "^6.1.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}